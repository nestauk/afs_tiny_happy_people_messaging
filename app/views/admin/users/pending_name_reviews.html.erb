<h1 class="text-4xl">Names pending review</h1>
<table class="table-auto w-full mt-8">
  <thead>
    <tr class="bg-blue-300 text-left">
      <th class="px-4 py-4">Phone number</th>
      <th class="px-4 py-4">Parent's name</th>
      <th class="px-4 py-4">Child's name</th>
      <td>
        &nbsp;
      </td>
    </tr>
  </thead>
  <tbody>
    <% if @pending_name_reviews.any? %>
      <% @pending_name_reviews.each do |user| %>
        <tr class="border-b-2">
          <td class="px-4 py-4 bg-white">
            <%= link_to user.phone_number, admin_user_path(user), class: "underline hover:no-underline" %>
          </td>
          <td class="px-4 py-4 bg-white"><%= user.first_name %></td>
          <td class="px-4 py-4 bg-white"><%= user.child_name %></td>
          <td class="px-4 py-4 bg-white flex gap-2 justify-end">
            <%= button_to "Approve", approve_name_admin_user_path(user), method: :patch, class: "btn btn-primary" %>
            <%= button_to "Reject", reject_name_admin_user_path(user), method: :delete, form: {onsubmit: "return confirm('Are you sure? This will permanently delete the user.')"}, class: "btn text-white bg-bbc-red" %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr class="border-b-2">
        <td class="px-4 py-4 bg-white">No names are pending review</td>
      </tr>
    <% end %>
  </tbody>
</table>
