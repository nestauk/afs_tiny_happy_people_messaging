<div class="mb-2">
  <%= link_to '< Back', admin_user_path(@user), class: 'underline hover:no-underline' %>
</div>
<h1>
  Change age of content user is receiving
</h1>
<% if @user.last_content.present? %>
  <p>Currently receiving content for <%= @user.content_in_months %> month old</p>
<% else %>
  <p>Will start receiving content for <%= @user.content_in_months %> month old</p>
<% end %>

<%= form_for @user, url: admin_user_path(@user), method: :patch do |f| %>
  <div class="mt-5 flex w-full gap-5 items-end">
    <div class="flex flex-col w-1/3">
      <%= f.label :content_in_months, "Age in months of content they should receive" %>
      <% if @user.errors[:content_in_months].any? %>
        <p class="text-red-600 font-bold"><%= @user.errors[:content_in_months].to_sentence %></p>
      <% end %>
      <%= f.text_field :content_in_months %>
    </div>

    <div class="flex flex-col w-1/3">
      <%= f.label :video_number, "Video number" %>
      <% if @user.errors[:video_number].any? %>
        <p class="text-red-600 font-bold"><%= @user.errors[:video_number].to_sentence %></p>
      <% end %>
      <%= f.text_field :video_number, class: "!grow-0" %>
    </div>
  </div>


  <p>
    After updating, please send a message to the user letting them know about the change.
  </p>
  <%= f.submit "Update", class: "btn btn-primary w-1/4" %>

  <div class="mt-4 border border-blue-500 p-4 rounded bg-white">
    <p>
      Example message to user:
    </p>
    <p class="mt-4">
      Thank you for letting us know! We’ve adjusted the activities we send to better suit [Child Name]’s current age and stage. Look out for your next message, which will feature ideas tailored to support their development right where they are.
    </p>
    <p class="mt-1">
      Remember, this is an automated service. If you have any concerns about your child's language that aren't addressed, please contact your health visitor, GP or local flying start centre.
    </p>
  </div>
<% end %>
