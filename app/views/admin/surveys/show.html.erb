<div class="mb-2">
  <%= link_to '< Back to surveys'.html_safe, admin_surveys_path, class: 'text-sm text-gray-600 underline hover:no-underline' %>
</div>

<div class="flex justify-between items-start gap-4 mb-6">
  <div>
    <h1 class="text-4xl font-bold mb-2"><%= @survey.title_en %></h1>
    <div class="text-sm text-gray-600 flex flex-wrap items-center gap-2">
      <% count = @survey.completed_respondent_count %>
      <% if @survey.max_responses.present? %>
        <%= link_to "#{count} / #{@survey.max_responses} responses", admin_survey_answers_path(@survey), class: "link" %>
      <% else %>
        <%= link_to "#{count} responses (unlimited)", admin_survey_answers_path(@survey), class: "link" %>
      <% end %>
    </div>
  </div>
  <%= link_to "Edit survey", edit_admin_survey_path(@survey), class: "btn bg-bbc-blue text-white whitespace-nowrap" %>
</div>

<div class="flex flex-wrap gap-2 mb-6">
  <%= link_to "New survey section", new_admin_survey_survey_section_path(@survey), class: "btn bg-green-600 text-white" %>
  <%= link_to "Preview survey (English)", preview_admin_survey_path(@survey, locale: "en"), class: "btn bg-bbc-blue text-white" %>
  <%= link_to "Preview survey (Welsh)", preview_admin_survey_path(@survey, locale: "cy"), class: "btn bg-bbc-blue text-white" %>
  <%= link_to "Preview thank you", preview_thank_you_admin_survey_path(@survey), class: "btn bg-bbc-blue text-white" %>
</div>

<div class="rounded-lg shadow-sm overflow-hidden">
  <table class="table-auto w-full">
    <thead>
      <tr class="bg-blue-300 text-left">
        <th class="px-4 py-4">&nbsp;</th>
        <th class="px-4 py-4">Title</th>
        <th class="px-4 py-4">Type</th>
        <th class="px-4 py-4">Options</th>
        <th class="px-4 py-4">&nbsp;</th>
      </tr>
    </thead>
    <tbody data-controller="sortable" data-sortable-handle-value=".cursor-grab">
      <% @survey.survey_sections.order(:position).each_with_index do |section, i| %>
        <tr class="border-b-2 bg-blue-100">
          <td colspan="5" class="p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <strong class="text-lg"><%= section.title_en %></strong>
              <div class="flex items-center gap-3 text-sm">
                <%= link_to "New question", new_admin_survey_survey_section_question_path(@survey, section), class: "link whitespace-nowrap" %>
                <%= link_to "Edit", edit_admin_survey_survey_section_path(@survey, section), class: "link" %>
                <%= button_to "Delete", admin_survey_survey_section_path(@survey, section), method: :delete, form: {onsubmit: "return confirm('Are you sure?')"}, class: "link text-left text-bbc-red bg-transparent border-0 p-0 cursor-pointer" %>
              </div>
            </div>
          </td>
        </tr>
        <% section.questions.order(:position).each do |question| %>
          <tr class="border-b-2 <%= i % 2 == 0 ? 'bg-white' : 'bg-blue-50' %> hover:bg-gray-100" data-sortable-update-url="<%= update_position_admin_survey_survey_section_question_path(@survey, section, question) %>">
            <td class="p-4">
              <svg class="cursor-grab" width="20px" height="20px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#ccc"><path d="M3 5H21" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12H21" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 19H21" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </td>
            <td class="px-4 py-4">
              <%= question.text_en %>
              <% if question.language.present? %>
                <span class="text-sm text-gray-500">(<%= question.language == "cy" ? "Welsh" : "English" %> only)</span>
              <% end %>
            </td>
            <td class="px-4 py-4"><%= question.question_type.humanize %></td>
            <td class="px-4 py-4">
              <% question.options_en.each do |option| %>
                <div><%= option %></div>
              <% end %>
            </td>
            <td class="px-4 py-4 whitespace-nowrap">
              <%= link_to "Edit", edit_admin_survey_survey_section_question_path(@survey, section, question), class: "link" %><br>
              <%= button_to "Delete", admin_survey_survey_section_question_path(@survey, section, question), method: :delete, form: {onsubmit: "return confirm('Are you sure?')"}, class: "link text-left text-bbc-red bg-transparent border-0 p-0 cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
