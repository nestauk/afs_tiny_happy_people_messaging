<div class="flex justify-between items-baseline">
  <h1 class="text-4xl mb-8">Auto responses</h1>
</div>
<p>Messages that the system sends automatically in response to users texting in.</p>
<table class="table-auto mt-5">
  <thead>
    <tr class="px-4 py-4 bg-blue-300 text-left">
      <th class="p-4 w-1/3">Description</th>
      <th class="p-4 w-1/6">User's message must match</th>
      <th class="p-4 w-1/3">Response</th>
      <th>&nbsp</th>
    </tr>
  </thead>
  <tbody class="bg-white">
    <% @auto_responses.each do |response| %>
      <tr class="border-b-2">
        <td class="p-4"><%= response.description %></td>
        <td class="p-4"><%= response.trigger_phrase %></td>
        <td class="p-4"><%= response.response %></td>
        <td class="p-4">
          <%= link_to "Edit", edit_admin_auto_response_path(response), class: "underline hover:no-underline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
